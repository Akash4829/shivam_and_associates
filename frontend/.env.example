# Local development
REACT_APP_API_URL=http://localhost:5000

# Production (Vercel) — choose ONE approach:
#
# A) Direct Render URL:
#    REACT_APP_API_URL=https://shivam-and-associates.onrender.com
#    Render must allow your Vercel origin (CLIENT_URL / CLIENT_URLS / ALLOW_VERCEL_PREVIEWS)
#
# B) Same-origin proxy (avoids CORS — recommended):
#    1. frontend/vercel.json already proxies /api/* to Render
#    2. Remove REACT_APP_API_URL on Vercel (or set it to your Vercel site URL)
#    3. Redeploy Vercel

# Stable public site URL (Vercel production). Required for Google redirect OAuth
# so preview deploy hosts (…-xxxxx.vercel.app) do not become redirect_uri.
REACT_APP_SITE_URL=https://shivam-and-associates-53go.vercel.app

# Google Sign-In (Vercel: must be REACT_APP_ prefix, then redeploy)
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional — Google One Tap on homepage (default off; can conflict with sign-in button)
# REACT_APP_GOOGLE_ONE_TAP=true

REACT_APP_APPLE_CLIENT_ID=your.apple.services.id

# Google Cloud Console → OAuth client:
# Authorized JavaScript origins (no trailing slash):
#   http://localhost:3000
#   https://shivam-and-associates-53go.vercel.app
#   https://shivam-and-associates.vercel.app
# Authorized redirect URIs:
#   http://localhost:3000
#   https://shivam-and-associates-53go.vercel.app/api/auth/google
#   https://shivam-and-associates.vercel.app/api/auth/google
