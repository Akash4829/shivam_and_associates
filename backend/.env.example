NODE_ENV=production
PORT=5000

# Primary frontend URL (must match the browser origin exactly — no trailing slash)
CLIENT_URL=https://shivam-and-associates-53go.vercel.app

# Extra frontend origins (comma-separated). Add every Vercel URL you use.
CLIENT_URLS=https://shivam-and-associates.vercel.app,https://shivam-and-associates-53go.vercel.app

# Allow any *.vercel.app origin (default). Set to false to require exact CLIENT_URL(S) only.
ALLOW_VERCEL_PREVIEWS=true

# PostgreSQL (use DATABASE_URL or individual vars)
DATABASE_URL=postgresql://user:password@host:5432/database
DB_USER=postgres
DB_HOST=localhost
DB_NAME=lawfirm_db
DB_PASSWORD=replace_with_secure_password
DB_PORT=5432

# Security
JWT_SECRET=replace_with_secure_random_string
JWT_EXPIRES_IN=30d
SESSION_SECRET=replace_with_secure_random_string
# Auth cookie SameSite policy.
#   - Leave unset for: 'none' in production (required when the frontend and API
#     are on DIFFERENT domains, e.g. Vercel + Render) / 'lax' in development.
#   - Set to 'lax' if the frontend and API are served from the SAME domain.
COOKIE_SAMESITE=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

APPLE_CLIENT_ID=your.apple.services.id

# Email notifications
# IMPORTANT: Render FREE tier blocks SMTP ports 25/465/587.
# Prefer Resend (HTTPS) in production:
#   1. Sign up at https://resend.com with the inbox you want alerts in
#   2. Create an API key → RESEND_API_KEY
#   3. For testing without a domain, set RESEND_FROM=onboarding@resend.dev
#      (Resend only delivers to your signup email until a domain is verified)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Gmail SMTP works locally / on paid Render — blocked on Render free
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sharmaakash64501@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Shivam Mishra & Associates" <sharmaakash64501@gmail.com>

# Inbox that receives appointment/internship alerts
FIRM_EMAIL=sharmaakash64501@gmail.com
